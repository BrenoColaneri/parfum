# ==============================================================================
# PARFUM - VARIÁVEIS DE AMBIENTE (.env.example)
# Copie este arquivo para .env e preencha com as credenciais do seu projeto.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE (Banco de Dados & Autenticação) - PÚBLICO (Client-side)
# Necessárias para que a aplicação React conecte à API REST e ao Auth do Supabase.
# Obtenha em: Supabase Dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL="https://seu-projeto.supabase.co"
VITE_SUPABASE_ANON_KEY="sua_chave_anonima_publica_jwt_aqui"

# ------------------------------------------------------------------------------
# 2. OPENWEATHER (Clima e Sensores) - PÚBLICO (Client-side)
# Utilizada para busca de clima com base na geolocalização do usuário.
# (Nota: O app possui fallback automático via Open-Meteo caso não configurada).
# ------------------------------------------------------------------------------
VITE_OPENWEATHER_API_KEY="sua_chave_openweather_aqui"

# ------------------------------------------------------------------------------
# 3. GOOGLE GEMINI API (Inteligência Artificial) - PRIVADA NO BACKEND / VERCEL
# ATENÇÃO: Em produção na Vercel, defina 'GEMINI_API_KEY' como variável privada
# de ambiente no painel da Vercel (Project Settings -> Environment Variables).
# O endpoint Serverless /api/gemini consumirá essa chave sem expô-la ao navegador.
# ------------------------------------------------------------------------------
GEMINI_API_KEY="sua_chave_secreta_gemini_para_serverless"

# Para desenvolvimento local simplificado via SDK direto (opcional):
VITE_GEMINI_API_KEY="sua_chave_gemini_para_dev_local_aqui"

